// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// user モジュール
// ユーザー・認証を扱う（フェーズ2）
// フェーズ1では匿名利用のみのため、実質未使用
// ============================================

/// 登録ユーザー
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  generationBatches GenerationBatch[]
  quizzes           Quiz[]
  attempts          Attempt[]
  accounts          Account[]
  sessions          Session[]

  @@map("users")
}

// ============================================
// quiz-catalog モジュール
// クイズ（1問単位）の保管・検索・正誤状態の管理
// 「生成する人」ではなく「保管し、条件で検索させる人」
// ============================================

/// 生成バッチ
/// 1回のURL入力によるクイズ生成イベントのメタ情報（いつ・どのURLから・何問生成したか）
/// 挑戦や正誤判定の単位としては使わない（あくまで記録用）
model GenerationBatch {
  id            String   @id @default(uuid())
  /// 匿名生成の場合は null
  userId        String?
  sourceUrl     String
  sourceTitle   String
  questionCount Int
  createdAt     DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]
  attempts Attempt[]

  @@index([userId, createdAt])
  @@map("generation_batches")
}

/// クイズ（1問単位のエンティティ。このアプリの真の主役）
/// 旧来の「URL単位の問題セット」ではなく、1問ごとに独立して検索・出題できる
model Quiz {
  id                String   @id @default(uuid())
  /// 匿名生成の場合は null
  userId            String?
  generationBatchId String

  /// 非正規化（generationBatchと重複して保持）
  /// URL単位の振り返り・URL指定の復習で、生成バッチを介さず単独検索するために必須
  sourceUrl    String
  sourceDomain String
  sourceTitle  String

  text          String
  /// JSON文字列（string[4]）。SQLiteが配列型を持たないため
  choices       String
  answerIndex   Int
  explanation   String
  sourceExcerpt String

  /// 最終回答の正誤。null = 未回答。復習対象を判定する唯一の基準
  lastIsCorrect  Boolean?
  lastAnsweredAt DateTime?

  createdAt DateTime @default(now())

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationBatch GenerationBatch @relation(fields: [generationBatchId], references: [id], onDelete: Cascade)
  attemptQuizzes  AttemptQuiz[]
  answers         Answer[]

  @@index([userId, lastIsCorrect]) // 全体からの復習対象の抽出用
  @@index([userId, sourceUrl])     // URL単位の振り返り・URL指定復習用
  @@index([userId, createdAt])     // 一覧表示用
  @@map("quizzes")
}

// ============================================
// quiz-session モジュール
// 出題・回答・採点（挑戦の実行）を扱う
// 通常出題・復習出題を同一のAttemptとして共通に扱う
// ============================================

/// 挑戦（セッション）
/// 出題モード（通常/全体復習/URL復習）を問わず同じ形で表現する
model Attempt {
  id     String  @id @default(uuid())
  /// 匿名挑戦の場合は null
  userId String?

  /// 出題モード: "normal" | "review_all" | "review_url"
  /// SQLiteがenumを持たないためString。値の妥当性はアプリ側で担保する
  mode String

  /// mode = "review_url" のときのみ使用
  sourceUrl String?
  /// mode = "normal" のときのみ使用
  generationBatchId String?

  startedAt  DateTime  @default(now())
  /// null は進行中・未完了を意味する
  finishedAt DateTime?
  /// 完了時に確定する正答数
  score      Int?

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationBatch GenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: SetNull)
  attemptQuizzes  AttemptQuiz[]
  answers         Answer[]

  @@index([userId, startedAt])
  @@map("attempts")
}

/// 出題対象のスナップショット
/// セッション開始時に確定した出題対象クイズを保持し、以後は変動させない
/// （復習中に正解して lastIsCorrect が変わっても、そのセッションの出題内容は変わらない）
model AttemptQuiz {
  attemptId  String
  quizId     String
  /// 出題順（0始まり）
  orderIndex Int

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([attemptId, quizId])
  @@unique([attemptId, orderIndex])
  @@map("attempt_quizzes")
}

/// 回答
/// 1つの挑戦（Attempt）内で、1つのクイズに対して行った回答
model Answer {
  id            String   @id @default(uuid())
  attemptId     String
  quizId        String
  selectedIndex Int
  /// 回答時に確定し、以後不変（採点ロジックの変更が過去の結果に影響しないようにするため）
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([attemptId, quizId]) // 同一セッション内での同一クイズへの二重回答を防止
  @@index([quizId, answeredAt]) // 正答率の推移グラフ集計用
  @@map("answers")
}

// ============================================
// user モジュール（続き）
// Auth.js（NextAuth）標準スキーマ（フェーズ2）
// アダプタが要求する形式に合わせているため、命名規則を他モデルと揃えていない
// ============================================

/// OAuthプロバイダとの連携情報
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// ログインセッション
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// メール確認・パスワードリセット等の一時トークン
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
<mxfile host="app.diagrams.net" type="device">
  <diagram name="モジュール構成" id="quizstack-modules">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="QuizStack — モジュール構成図" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="16" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="業務上の関心事ごとに modules/ を分けるモジュラーモノリス。矢印は import の向き（＝依存の向き）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="44" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="app" value="app/ — 画面とルーティングのみ。業務ロジックは持たない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacing=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1280" height="110" as="geometry"/></mxCell>
        <mxCell id="pg0" value="/ ホーム" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="80" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg1" value="/generating" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="238" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg2" value="/attempt/[id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="396" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg3" value="/attempt/[id]/result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="554" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg4" value="/dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="712" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg5" value="/quizzes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg6" value="/review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1028" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="pg7" value="(auth) /login /signup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1186" y="125" width="148" height="44" as="geometry"/></mxCell>
        <mxCell id="mods" value="modules/ — ドメインごとのモジュール" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;align=left;spacing=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1280" height="440" as="geometry"/></mxCell>
        <mxCell id="extract" value="&lt;b&gt;content-extraction&lt;/b&gt;&lt;br&gt;URLから本文を抽出&lt;br&gt;ExtractedContent&lt;br&gt;&lt;br&gt;&lt;i&gt;※モック（ネットワーク未使用）&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="gen" value="&lt;b&gt;quiz-generation&lt;/b&gt;&lt;br&gt;抽出結果からクイズを生成&lt;br&gt;QuizItem&lt;br&gt;&lt;br&gt;&lt;i&gt;※モック（常に3問）&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="catalog" value="&lt;b&gt;quiz-catalog&lt;/b&gt;&lt;br&gt;保管・検索・正誤状態&lt;br&gt;Quiz / GenerationBatch&lt;br&gt;&lt;br&gt;&lt;i&gt;復習対象を決める土台&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="300" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="analytics" value="&lt;b&gt;analytics&lt;/b&gt;&lt;br&gt;学習状況の集計&lt;br&gt;Dashboard / StudyCalendar&lt;br&gt;&lt;br&gt;&lt;i&gt;他モジュールを import しない&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;user&lt;/b&gt;&lt;br&gt;登録・認証・セッション&lt;br&gt;User / Session / RawPassword&lt;br&gt;&lt;br&gt;&lt;i&gt;どこにも依存しない&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="530" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="session" value="&lt;b&gt;quiz-session&lt;/b&gt;&lt;br&gt;出題・回答・採点&lt;br&gt;Attempt / AttemptQuiz / Answer&lt;br&gt;&lt;br&gt;&lt;i&gt;通常も復習も同じ Attempt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="530" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="lib" value="&lt;b&gt;lib/&lt;/b&gt; 全モジュール共通の土台&lt;br&gt;container.ts / errors.ts / action-result.ts&lt;br&gt;server-logger.ts / constants.ts / prisma.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="db" value="Prisma 7 + SQLite（dev.db）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="755" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;凡例&lt;/b&gt;　■ 青 = 本実装／■ 橙 = モック&lt;br&gt;　→ 実線 = import による依存&lt;br&gt;　⇢ 紫破線 = Prisma 経由の暗黙の依存&lt;br&gt;　⇢ &lt;font color=&#x27;#B85450&#x27;&gt;赤破線 = モジュール間の循環&lt;/font&gt;&lt;br&gt;&lt;b&gt;「認証を要求」&lt;/b&gt; = requireUserOrThrow()／&lt;b&gt;直読み&lt;/b&gt; = quizzes・answers・attempts&lt;br&gt;&lt;b&gt;循環の中身&lt;/b&gt;：quiz-catalog の components が&lt;br&gt;quiz-session/actions の startReviewAction を呼ぶ一方、&lt;br&gt;quiz-session の use-cases は quiz-catalog を import する。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="740" width="420" height="140" as="geometry"/></mxCell>
        <mxCell id="e_app" value="index.ts（サーバー） / actions.ts（&#x27;use client&#x27;） / components/*.tsx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;strokeWidth=2;" edge="1" parent="1" source="app" target="mods"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="本文を抽出する" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="extract"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="クイズを保管する" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="出題を始める" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.17;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="session"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="480"/><mxPoint x="791" y="480"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="正誤を書き戻す" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="復習を開始する" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#B85450;fontColor=#B85450;dashed=1;strokeWidth=2;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="session"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="認証を要求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="user"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="認証を要求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="session" target="user"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="各モジュールの infrastructure/ が Prisma を叩く" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#4D4D4D;strokeWidth=2;exitX=0.42;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mods" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="テーブルを直読み（読み取り専用）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;dashed=1;strokeColor=#9673A6;fontColor=#9673A6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="analytics" target="db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="710"/><mxPoint x="794" y="710"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=open;dashed=1;strokeColor=#9673A6;fontColor=#9673A6;exitX=0.11;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mods" target="lib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
